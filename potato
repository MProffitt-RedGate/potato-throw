#!/usr/bin/env bash
# potato-throw: an asynchronous game of hot potato. See GLOSSARY.md.
set -u

SCRIPT="$(readlink -f "${BASH_SOURCE[0]}")"
REPO="$(dirname "$SCRIPT")"
STATE="$REPO/game.txt"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/potato-throw"
NAME_FILE="$CONFIG_DIR/name"

git_repo() { git -C "$REPO" "$@"; }

# pull: fast-forward only; git's complaint (in English, for sync_remote to classify) goes to stdout.
pull() { LC_ALL=C git_repo pull -q --ff-only 2>&1 >/dev/null; }

# pull_moved: pull, and succeed only if the remote had new commits (i.e. our push lost a race).
pull_moved() {
  local before; before="$(git_repo rev-parse HEAD)"
  pull >/dev/null 2>&1
  [[ "$(git_repo rev-parse HEAD)" != "$before" ]]
}

# sync_remote: pull at launch. Sets SYNC to ok, offline or failed (and SYNC_ERR to git's reason).
# Anything but "ok" leaves the Game read-only: Throw, Invite and joining need a current view.
SYNC=ok; SYNC_ERR=""
sync_remote() {
  local err
  if err="$(pull 2>&1)"; then SYNC=ok; return 0; fi
  SYNC_ERR="$(grep -m1 -iE '^(fatal|error):' <<<"$err" | sed -E 's/^(fatal|error): *//')"
  # Refusals first: "Could not read from remote repository" also follows a denied login.
  if grep -qiE 'permission denied|authentication failed|access denied|forbidden|returned error: (401|403|404)|ssl certificate|not possible to fast-forward|unrelated histories|would be overwritten|diverg' <<<"$err"; then
    SYNC=failed
  elif grep -qiE 'could not resolve host|temporary failure in name resolution|connection (refused|timed out|reset)|network is unreachable|no route to host|unable to access|could not read from remote repository|does not appear to be a git repository|timed out' <<<"$err"; then
    SYNC=offline
  else
    SYNC=failed
  fi
  return 1
}

publish() { # publish MESSAGE: commit and push game.txt; on failure restore the pre-publish state
  local before; before="$(git_repo rev-parse HEAD)"
  if git_repo add game.txt && git_repo commit -q -m "$1" && git_repo push -q >&2; then
    return 0
  fi
  git_repo reset -q --soft "$before"
  git_repo reset -q "$before" -- game.txt
  # Restore game.txt as it was; if it didn't exist before, the caller removes it.
  git_repo cat-file -e "$before:game.txt" 2>/dev/null && git_repo checkout -q -- game.txt
  return 1
}

publish_failed() { # publish_failed WHAT
  echo "Couldn't publish the $1: nothing was changed." >&2
  echo "Check your connection and that you have push access to the shared repository, then try again." >&2
}

ask_name() { # ask_name PROMPT
  local name
  while true; do
    printf '%s' "$1" >&2; read -r name || return 1
    if [[ -z "$name" || "$name" == *"|"* ]]; then
      echo "A Name can't be empty or contain '|'." >&2
    else
      printf '%s' "$name"; return
    fi
  done
}

start_game() { # start_game NAME: create the Game with NAME as First Player and Holder
  printf 'holder|%s\nplayer|%s|claimed\n' "$1" "$1" > "$STATE"
  if ! publish "Start the Game: $1 is the First Player"; then
    rm -f "$STATE"
    return 1
  fi
}

player_exists() { # case-insensitive, exact match
  N="$1" awk -F'|' '$1 == "player" && tolower($2) == tolower(ENVIRON["N"]) { found = 1 } END { exit !found }' "$STATE"
}

# add_invite NAME: 0 = published, 1 = push failed, 2 = the Name is taken.
add_invite() {
  player_exists "$1" && return 2
  printf 'player|%s|unclaimed\n' "$1" >> "$STATE"
  publish "Invite $1" >&2
}

read_only_reason() { # why Throw, Invite and joining are unavailable (only call when SYNC != ok)
  if [[ "$SYNC" == offline ]]; then echo "You're offline"; else echo "The shared repository couldn't be updated"; fi
}

invite() {
  local name rc
  if [[ "$SYNC" != ok ]]; then echo "$(read_only_reason), so you can't Invite anyone right now."; return 0; fi
  name="$(ask_name "Name to invite: ")" || return 0
  add_invite "$name"; rc=$?
  # Lost a race: re-pull, recheck the Name is still free, retry once.
  if [[ $rc -eq 1 ]] && pull_moved; then add_invite "$name"; rc=$?; fi
  case $rc in
    0) echo "Invited $name. Tell them yourself: no message is sent." ;;
    2) echo "There is already a Player called $name." ;;
    *) publish_failed Invite ;;
  esac
}

unclaimed_names() {
  awk -F'|' '$1 == "player" && $3 == "unclaimed" { print $2 }' "$STATE"
}

# claim NAME: mark an invited Name as Claimed (permanent) and publish it.
claim() {
  N="$1" awk -F'|' -v OFS='|' '$1 == "player" && $2 == ENVIRON["N"] && $3 == "unclaimed" { $3 = "claimed" } { print }' "$STATE" > "$STATE.new" \
    && mv "$STATE.new" "$STATE" && publish "Claim $1" >&2
  local rc=$?
  rm -f "$STATE.new"
  return $rc
}

join_game() { # choose an invited Name to Claim; prints the chosen Name on success
  local names=() n choice i
  while IFS= read -r n; do names+=("$n"); done < <(unclaimed_names)
  if [[ ${#names[@]} -eq 0 ]]; then
    echo "A Game is already running, but there are no invited Names left to Claim." >&2
    echo "Ask a Player to Invite you, then launch again." >&2
    return 1
  fi
  echo "A Game is already running. Claim your Name:" >&2
  for i in "${!names[@]}"; do echo "  $((i+1))) ${names[$i]}" >&2; done
  while true; do
    printf 'Your number: ' >&2; read -r choice || return 1
    if [[ "$choice" =~ ^[0-9]{1,4}$ ]] && (( 10#$choice >= 1 && 10#$choice <= ${#names[@]} )); then
      n="${names[$((10#$choice-1))]}"
      claim "$n" || { echo "Couldn't publish the Claim." >&2; return 1; }
      printf '%s' "$n"; return 0
    fi
    echo "Please choose one of the numbers listed." >&2
  done
}

holder() { sed -n 's/^holder|//p' "$STATE"; }

other_players() { # other_players ME
  N="$1" awk -F'|' '$1 == "player" && $2 != ENVIRON["N"] { print $2 }' "$STATE"
}

# record_throw FROM TO: make TO the Holder and append the Throw record (who, to whom, when).
record_throw() {
  local when; when="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  FROM="$1" TO="$2" WHEN="$when" awk -F'|' -v OFS='|' '
    $1 == "holder" { $2 = ENVIRON["TO"] }
    { print }
    END { print "throw", ENVIRON["FROM"], ENVIRON["TO"], ENVIRON["WHEN"] }' "$STATE" > "$STATE.new" \
    && mv "$STATE.new" "$STATE" && publish "Throw: $1 to $2" >&2
  local rc=$?
  rm -f "$STATE.new"
  [[ $rc -eq 0 ]]
}

# attempt_throw FROM TO: 0 = thrown, 1 = push failed, 2 = FROM is not the Holder (any more).
attempt_throw() {
  [[ "$(holder)" == "$1" ]] || return 2
  record_throw "$1" "$2" && return 0
  return 1
}

throw() { # throw ME
  local me="$1" names=() n choice i rc
  if [[ "$SYNC" != ok ]]; then echo "$(read_only_reason), so you can't Throw right now."; return 0; fi
  if [[ "$(holder)" != "$me" ]]; then
    echo "Only the Holder can Throw."
    return 0
  fi
  while IFS= read -r n; do names+=("$n"); done < <(other_players "$me")
  if [[ ${#names[@]} -eq 0 ]]; then
    echo "You're the only Player. Invite someone first."
    return 0
  fi
  echo "Throw the potato at:"
  for i in "${!names[@]}"; do echo "  $((i+1))) ${names[$i]}"; done
  while true; do
    printf 'Your number: '; read -r choice || return 0
    if [[ "$choice" =~ ^[0-9]{1,4}$ ]] && (( 10#$choice >= 1 && 10#$choice <= ${#names[@]} )); then
      n="${names[$((10#$choice-1))]}"
      attempt_throw "$me" "$n"; rc=$?
      # Lost a race: re-pull, recheck we are still the Holder, retry once.
      if [[ $rc -eq 1 ]] && pull_moved; then attempt_throw "$me" "$n"; rc=$?; fi
      case $rc in
        0) echo "You threw the potato to $n." ;;
        2) echo "Too late: $(holder) has the potato now." ;;
        *) publish_failed Throw ;;
      esac
      return 0
    fi
    echo "Please choose one of the numbers listed."
  done
}

show_holder() { # show_holder ME
  if [[ "$(holder)" == "$1" ]]; then
    echo "You have the potato!"
  else
    echo "$(holder) has the potato."
  fi
}

show_history() { # the last 5 Throws, newest first
  local lines
  lines="$(awk -F'|' '$1 == "throw" { n++; from[n] = $2; to[n] = $3; at[n] = $4 }
    END { for (i = n; i > 0 && i > n - 5; i--) printf "  %s -> %s  (%s)\n", from[i], to[i], at[i] }' "$STATE")"
  if [[ -n "$lines" ]]; then
    echo "Last Throws:"
    echo "$lines"
  else
    echo "No Throws yet."
  fi
}

show_sync_warning() {
  case "$SYNC" in
    offline) echo "Warning: offline, may be out of date. Showing the last-known state; Throw and Invite are unavailable." ;;
    failed)  echo "Warning: Couldn't update from the shared repository${SYNC_ERR:+ ($SYNC_ERR)}." ; echo "Showing the last-known state; Throw and Invite are unavailable until this is fixed." ;;
  esac
}

menu() {
  local me="$1" choice options
  show_sync_warning
  show_holder "$me"
  show_history
  while true; do
    options="[i] invite  [q] quit"
    [[ "$(holder)" == "$me" ]] && options="[t] throw  $options"
    [[ "$SYNC" != ok ]] && options="[q] quit"
    printf '%s: ' "$options"; read -r choice || return 0
    case "$choice" in
      t|T) throw "$me"; show_holder "$me"; show_history ;;
      i|I) invite ;;
      q|Q) return 0 ;;
      *) echo "Please choose one of the options." ;;
    esac
  done
}

main() {
  sync_remote
  mkdir -p "$CONFIG_DIR"
  if [[ ! -f "$STATE" ]]; then
    if [[ "$SYNC" != ok ]]; then
      if [[ "$SYNC" == offline ]]; then
        echo "Can't reach the shared repository, so I can't tell whether a Game already exists." >&2
        echo "Try again when you're online." >&2
      else
        echo "Couldn't update from the shared repository${SYNC_ERR:+ ($SYNC_ERR)}, so I can't tell whether a Game already exists." >&2
      fi
      exit 1
    fi
    local name; name="$(ask_name "Choose a Name: ")" || exit 1
    printf '%s\n' "$name" > "$NAME_FILE"
    start_game "$name" || { rm -f "$NAME_FILE"; echo "Couldn't publish the Game." >&2; exit 1; }
  fi
  if [[ ! -f "$NAME_FILE" ]]; then
    if [[ "$SYNC" != ok ]]; then
      echo "$(read_only_reason), and you need an up-to-date view to join. Get online and try again." >&2
      exit 1
    fi
    local claimed; claimed="$(join_game)" || exit 1
    printf '%s\n' "$claimed" > "$NAME_FILE"
  fi
  menu "$(cat "$NAME_FILE")"
}

# A link we may replace: dangling, or pointing at a potato-throw script (e.g. another clone).
is_potato_link() {
  [[ -L "$1" ]] || return 1
  [[ ! -e "$1" ]] || grep -q '^# potato-throw' "$1"
}

install_self() { # symlink this script into ~/.local/bin so `potato` works from anywhere
  local bin="$HOME/.local/bin" dest="$HOME/.local/bin/potato" verb=Installed
  mkdir -p "$bin" || return 1
  if [[ -e "$dest" || -L "$dest" ]]; then
    if [[ "$(readlink -f "$dest")" == "$SCRIPT" ]]; then
      verb="Already installed"
    elif is_potato_link "$dest"; then
      ln -sfn "$SCRIPT" "$dest" || return 1
      verb="Re-pointed"
    else
      echo "$dest already exists and isn't a link to potato; leaving it alone." >&2
      return 1
    fi
  else
    ln -s "$SCRIPT" "$dest" || return 1
  fi
  echo "$verb: $dest -> $SCRIPT"
  case ":$PATH:" in
    *":$bin:"*) ;;
    *) echo "Note: $bin isn't on your PATH. Add this to your shell profile:  export PATH=\"\$HOME/.local/bin:\$PATH\"" ;;
  esac
}

case "${1:-}" in
  "")      main ;;
  install) install_self ;;
  *)       echo "Usage: potato [install]" >&2; exit 2 ;;
esac
